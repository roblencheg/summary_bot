# Public origin, without a path. Use HTTPS behind a reverse proxy in production.
PUBLIC_BASE_URL=http://localhost:3000
# Publish on localhost by default. Set 0.0.0.0 for access from a separate proxy/LAN.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
# First start only; other superadmins are created in Settings → Administrators.
ADMIN_INITIAL_LOGIN=admin
ADMIN_INITIAL_PASSWORD=
# Leave tokens empty to disable integrations. Use one polling instance per token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=off
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
MAX_MODE=off
MAX_WEBHOOK_SECRET=
# A provider supporting Responses API and strict JSON schema is required.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DEFAULT_TIMEZONE=UTC
# Optional additional trusted CA (host path). See README for MAX.
EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
