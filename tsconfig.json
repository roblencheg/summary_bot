{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "~shared/*": ["shared/*"],
      "~/*": ["src/*"],
      "~server/*": ["server/*"]
    }
  },
  "include": ["src", "server", "shared", "scripts", "tutorial-video/seed"]
}
